<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <LinearLayout
        android:layout_margin="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/custer_tel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="35dp"
            android:text="010-5442-6043"
            android:textStyle="bold"
            android:textColor="@color/black"/>
        <TextView
            android:id="@+id/customer_jibun_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:text="답십리로 63길 114"
            android:layout_marginVertical="5dp"/>
        <TextView
            android:id="@+id/customer_road_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:text="답십리로 63길 114"
            android:layout_marginVertical="5dp"/>
        <com.naver.maps.map.MapView
            android:id="@+id/map_view"
            android:layout_height="250dp"
            android:layout_width="match_parent"/>
        <TextView
            android:id="@+id/customer_remarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button
                android:id="@+id/order_delivery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="배달 주문"/>
            <Button
                android:id="@+id/customer_delete_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="삭제"/>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>